 "html": "<div style=\"font-family: Arial, sans-serif; max-width: 650px; margin: 0 auto; padding: 20px; border: 2px solid #333; border-radius: 8px;\">\n\t<div style=\"text-align: center; border-bottom: 2px solid #333; padding-bottom: 10px; margin-bottom: 15px;\">\n\t\t<h2 style=\"margin: 0; color: #1a365d; text-transform: uppercase;\">{{ doc.company or \"HOSPITAL / CLINIC\" }}</h2>\n\t\t<h4 style=\"margin: 5px 0 0 0; color: #4a5568;\">OPD REGISTRATION SLIP</h4>\n\t</div>\n\n\t{% set print_count = frappe.db.get_value(\"OPD Form\", doc.name, \"print_count\") or doc.print_count or 0 %}\n\t{% if print_count > 1 %}\n\t<div style=\"text-align: center; background-color: #fff5f5; border: 2px solid #e53e3e; color: #c53030; padding: 8px 12px; border-radius: 6px; margin-bottom: 15px; font-weight: bold; font-size: 14px; letter-spacing: 0.5px; text-transform: uppercase;\">\n\t\t\u26a0\ufe0f DUPLICATE SLIP (Print #{{ print_count }}) \u2014 This slip has been printed more than once\n\t</div>\n\t{% endif %}\n\n\t<div style=\"text-align: center; background-color: #ebf8ff; border: 2px dashed #3182ce; padding: 15px; border-radius: 8px; margin-bottom: 20px;\">\n\t\t<div style=\"font-size: 14px; font-weight: bold; color: #2b6cb0; text-transform: uppercase; letter-spacing: 1px;\">TOKEN NUMBER</div>\n\t\t<div style=\"font-size: 48px; font-weight: 900; color: #2c5282; margin: 5px 0;\">#{{ doc.token_no or \"-\" }}</div>\n\t\t<div style=\"font-size: 12px; color: #718096;\">Please wait for your token number to be called</div>\n\t</div>\n\n\t<table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 14px;\">\n\t\t<tr>\n\t\t\t<td style=\"padding: 8px; font-weight: bold; width: 25%; color: #4a5568;\">OPD Form No:</td>\n\t\t\t<td style=\"padding: 8px; width: 25%;\">{{ doc.name }}</td>\n\t\t\t<td style=\"padding: 8px; font-weight: bold; width: 25%; color: #4a5568;\">Date:</td>\n\t\t\t<td style=\"padding: 8px; width: 25%;\">{{ frappe.utils.formatdate(doc.date) }}</td>\n\t\t</tr>\n\t\t<tr style=\"background-color: #f7fafc;\">\n\t\t\t<td style=\"padding: 8px; font-weight: bold; color: #4a5568;\">Phone No:</td>\n\t\t\t<td style=\"padding: 8px;\">{{ doc.phone_no }}</td>\n\t\t\t<td style=\"padding: 8px; font-weight: bold; color: #4a5568;\">Patient Name:</td>\n\t\t\t<td style=\"padding: 8px; font-weight: bold;\">{{ doc.patient_name }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"padding: 8px; font-weight: bold; color: #4a5568;\">Gender:</td>\n\t\t\t<td style=\"padding: 8px;\">{{ doc.gender }}</td>\n\t\t\t<td style=\"padding: 8px; font-weight: bold; color: #4a5568;\">Status:</td>\n\t\t\t<td style=\"padding: 8px; font-weight: bold; color: #2b6cb0;\">{{ doc.status }}</td>\n\t\t</tr>\n\t\t<tr style=\"background-color: #f7fafc;\">\n\t\t\t<td style=\"padding: 8px; font-weight: bold; color: #4a5568;\">Doctor:</td>\n\t\t\t<td style=\"padding: 8px; font-weight: bold;\">{{ doc.doctor }}</td>\n\t\t\t<td style=\"padding: 8px; font-weight: bold; color: #4a5568;\">Session & Time:</td>\n\t\t\t<td style=\"padding: 8px;\">\n\t\t\t\t<strong>{{ doc.session_name or doc.doctor_session }}</strong>\n\t\t\t\t{% if doc.from_time and doc.to_time %}\n\t\t\t\t\t<br><span style=\"font-size: 12px; color: #4a5568;\">({{ doc.from_time }} - {{ doc.to_time }})</span>\n\t\t\t\t{% endif %}\n\t\t\t</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"padding: 8px; font-weight: bold; color: #4a5568;\">Checkup Fee:</td>\n\t\t\t<td style=\"padding: 8px; font-weight: bold; color: #2f855a;\">{{ frappe.utils.fmt_money(doc.checkup_fee, currency=\"PKR\") }}</td>\n\t\t\t<td style=\"padding: 8px; font-weight: bold; color: #4a5568;\">Sales Invoice:</td>\n\t\t\t<td style=\"padding: 8px;\">{{ doc.sales_invoice or \"-\" }}</td>\n\t\t</tr>\n\t</table>\n\n\t<div style=\"text-align: center; border-top: 1px solid #e2e8f0; padding-top: 10px; margin-top: 20px; font-size: 12px; color: #718096;\">\n\t\tPlease keep this registration slip until your consultation is completed.<br>\n\t\tThank you for visiting {{ doc.company or \"our clinic\" }}.\n\t</div>\n</div>",
